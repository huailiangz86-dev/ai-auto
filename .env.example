# ============================================================
# AI auto - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ============================================================

# ============================================================
# Application
# ============================================================

NODE_ENV=development
APP_NAME=ai-auto
PORT=3000
API_PREFIX=api/v1

# ============================================================
# Database (PostgreSQL)
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ai_auto
DB_PASSWORD=ai_auto_dev
DB_NAME=ai_auto_dev
DB_SYNCHRONIZE=true          # ONLY true in development!
DB_LOGGING=false

# ============================================================
# Redis
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# Authentication
# ============================================================

# JWT - CHANGE THIS IN PRODUCTION! Use a strong random string
JWT_SECRET=dev-secret-change-in-production-use-32-char-minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3100

# ============================================================
# Rate Limiting
# ============================================================

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ============================================================
# AI Agent Service (FastAPI)
# ============================================================

AI_AGENT_SERVICE_URL=http://localhost:8000
AI_AGENT_API_KEY=

# ============================================================
# AI Providers
# ============================================================

# Text generation (used by growth plans, campaign/coupon plans and product drafts)
DEFAULT_LLM_PROVIDER=qwen
LLM_FALLBACK_PROVIDER=doubao
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_DEFAULT_MODEL=qwen-plus
QWEN_IMAGE_MODEL=qwen-image-3.0
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_DEFAULT_MODEL=doubao-seed-2-0-lite-260215
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_GENERATE_AUDIO=true

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2
# Public URL of the AI service used for proxied completed video playback.
AI_AGENT_PUBLIC_URL=http://localhost:8000

# Kimi (Moonshot)
KIMI_API_KEY=

# RunningHub (AI Video Generation)
RUNNINGHUB_API_KEY=
RUNNINGHUB_API_URL=https://api.runninghub.com

# ============================================================
# Payment (Merchant Subscription & Agent Withdrawal)
# ============================================================

# Optional local adapter: load payment credentials from another .env file.
# Example: /Users/zhang/Documents/ViralForge/backend/.env
AI_AUTO_PAYMENT_ENV_FILE=
# Public origin where this API is reachable. Callback URLs are derived from it.
AI_AUTO_PUBLIC_BASE_URL=

# Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/merchant/subscription/payments/alipay/notify
ALIPAY_WALLET_NOTIFY_URL=https://your-domain.com/api/v1/merchant/wallet/topup/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/payment/return

# WeChat Pay
WECHATPAY_MCH_ID=
WECHATPAY_SERIAL_NO=
WECHATPAY_APP_ID=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=https://your-domain.com/api/v1/merchant/subscription/payments/wechatpay/notify
WECHATPAY_WALLET_NOTIFY_URL=https://your-domain.com/api/v1/merchant/wallet/topup/payments/wechatpay/notify
WECHATPAY_PLATFORM_CERTIFICATE=

# ============================================================
# SMS Verification
# ============================================================

# Aliyun SMS
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=AIauto
ALIYUN_SMS_TEMPLATE_CODE=

# ============================================================
# Content Security (AI Moderation)
# ============================================================

ALIYUN_CONTENT_SECURITY=false
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_REGION=cn-shanghai

# ============================================================
# Observability
# ============================================================

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================
# External Platforms OAuth
# ============================================================

# Douyin Open Platform
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=

# Xiaohongshu (RED)
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=

# WeChat Open Platform
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# Kuaishou Open Platform (website app with user_info,user_video_publish scopes)
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=

# WeChat Mini Program (C-end login and phone authorization)
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
